# FTC Predictor Local Development Environment Variables

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ftc_predictor
POSTGRES_USER=ftc_dev
POSTGRES_PASSWORD=ftc_dev_password

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default
DYNAMODB_ENVIRONMENT=stage

# FTC API Configuration (if needed for local testing)
FTC_API_USERNAME=your_username
FTC_API_KEY=your_api_key

# AWS Credentials (for teams fetcher and other AWS services)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# Local Development Settings
DEBUG=true
LOG_LEVEL=INFO

# Optional: Local API Server Settings
LOCAL_API_HOST=0.0.0.0
LOCAL_API_PORT=8000
